# Local Postgres (docker-compose.yml): postgres://dev:dev@localhost:5432/skyrocket
# Neon (prod): DATABASE_URL = pooled connection (pgbouncer), DIRECT_URL = direct connection.
# Locally both point at the same Docker Postgres.

DATABASE_URL=postgres://dev:dev@localhost:5432/skyrocket
DIRECT_URL=postgres://dev:dev@localhost:5432/skyrocket

# Signing key for the access/refresh JWTs kept in httpOnly cookies
# (lib/auth/tokens.ts). At least 32 characters; generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs every user out. Accounts are created through /register —
# there is no seeded user.
AUTH_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
