# Local Postgres (docker-compose.yml): postgres://dev:dev@localhost:5432/skyrocket
# Neon (prod): DATABASE_URL = pooled connection (pgbouncer), DIRECT_URL = direct connection.
# Locally both point at the same Docker Postgres.

DATABASE_URL=postgres://dev:dev@localhost:5432/skyrocket
DIRECT_URL=postgres://dev:dev@localhost:5432/skyrocket

# Single hardcoded app user (see lib/current-user.ts, scripts/seed-user.ts).
APP_USER_USERNAME=pavel
APP_USER_PASSWORD=change-me
