generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model app_user {
  id                    BigInt                  @id @default(autoincrement())
  username              String                  @unique
  password_hash         String
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  card_review_log       card_review_log[]
  card_state            card_state[]
  daily_activity        daily_activity[]
  error_map_entry       error_map_entry[]
  exercise_attempt      exercise_attempt[]
  flashcard             flashcard[]
  module_review         module_review[]
  review_queue_item     review_queue_item[]
  user_checkpoint_state user_checkpoint_state[]
  user_course           user_course[]
  user_grammar_state    user_grammar_state[]
  user_module_state     user_module_state[]
  user_session_state    user_session_state[]
  user_step_state       user_step_state[]
  user_vocab_state      user_vocab_state[]
  writing_submission    writing_submission[]
}

model block {
  id         BigInt       @id @default(autoincrement())
  course_id  BigInt
  slug       String
  name       String
  color      String
  tint       String
  position   Int
  course     course       @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  checkpoint checkpoint[]
  module     module[]

  @@unique([course_id, position])
  @@unique([course_id, slug])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model card_review_log {
  id           BigInt      @id @default(autoincrement())
  user_id      BigInt
  flashcard_id BigInt
  rating       Int         @db.SmallInt
  prev_phase   card_phase?
  new_due_at   DateTime?   @db.Timestamptz(6)
  reviewed_at  DateTime    @default(now()) @db.Timestamptz(6)
  flashcard    flashcard   @relation(fields: [flashcard_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  app_user     app_user    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, reviewed_at], map: "card_log_user_time_idx")
}

model card_state {
  user_id          BigInt
  flashcard_id     BigInt
  phase            card_phase @default(new)
  due_at           DateTime   @default(now()) @db.Timestamptz(6)
  interval_days    Decimal    @default(0) @db.Decimal(8, 2)
  ease             Decimal    @default(2.5) @db.Decimal(5, 2)
  reps             Int        @default(0)
  lapses           Int        @default(0)
  last_reviewed_at DateTime?  @db.Timestamptz(6)
  flashcard        flashcard  @relation(fields: [flashcard_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  app_user         app_user   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, flashcard_id])
  @@index([user_id, due_at], map: "card_state_due_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model checkpoint {
  id                    BigInt                  @id @default(autoincrement())
  course_id             BigInt
  block_id              BigInt?
  kind                  checkpoint_kind
  slug                  String
  title                 String
  pass_mark             Int?
  planned_minutes       Int                     @default(120)
  position              Int
  content_hash          String?
  block                 block?                  @relation(fields: [block_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  course                course                  @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  exercise              exercise[]
  user_checkpoint_state user_checkpoint_state[]
  writing_task          writing_task[]

  @@unique([course_id, slug])
}

model course {
  id            BigInt        @id @default(autoincrement())
  slug          String        @unique
  language      String
  name          String
  level_label   String
  position      Int           @default(1)
  is_active     Boolean       @default(true)
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  skeleton_hash String?
  block         block[]
  checkpoint    checkpoint[]
  user_course   user_course[]
}

model daily_activity {
  user_id        BigInt
  activity_date  DateTime @db.Date
  exercises_done Int      @default(0)
  cards_reviewed Int      @default(0)
  minutes        Int      @default(0)
  app_user       app_user @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, activity_date])
}

model error_map_entry {
  id                   BigInt              @id @default(autoincrement())
  user_id              BigInt
  module_id            BigInt?
  source               error_source
  source_attempt_id    BigInt?
  source_submission_id BigInt?
  error_text           String
  rule_note            String?
  flashcard_id         BigInt?
  created_at           DateTime            @default(now()) @db.Timestamptz(6)
  resolved_at          DateTime?           @db.Timestamptz(6)
  flashcard            flashcard?          @relation(fields: [flashcard_id], references: [id], onUpdate: NoAction)
  module               module?             @relation(fields: [module_id], references: [id], onUpdate: NoAction)
  exercise_attempt     exercise_attempt?   @relation(fields: [source_attempt_id], references: [id], onUpdate: NoAction)
  writing_submission   writing_submission? @relation(fields: [source_submission_id], references: [id], onUpdate: NoAction)
  app_user             app_user            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, created_at], map: "error_map_user_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model exercise {
  id                BigInt              @id @default(autoincrement())
  module_id         BigInt?
  checkpoint_id     BigInt?
  type_code         String
  pool              exercise_pool       @default(core)
  group_key         exercise_group?
  grammar_point_id  BigInt?
  reading_text_id   BigInt?
  content           Json
  explanation       String
  position          Int                 @default(1)
  content_hash      String?
  ident             String?
  checkpoint        checkpoint?         @relation(fields: [checkpoint_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  grammar_point     grammar_point?      @relation(fields: [grammar_point_id], references: [id], onUpdate: NoAction)
  module            module?             @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reading_text      reading_text?       @relation(fields: [reading_text_id], references: [id], onUpdate: NoAction)
  exercise_type     exercise_type       @relation(fields: [type_code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  exercise_attempt  exercise_attempt[]
  flashcard         flashcard[]
  review_queue_item review_queue_item[]

  @@index([checkpoint_id], map: "exercise_checkpoint_idx")
  @@index([module_id, pool], map: "exercise_module_idx")
}

model exercise_attempt {
  id                                                                        BigInt              @id @default(autoincrement())
  user_id                                                                   BigInt
  exercise_id                                                               BigInt
  context                                                                   attempt_context
  given_answer                                                              Json?
  is_correct                                                                Boolean
  time_ms                                                                   Int?
  answered_at                                                               DateTime            @default(now()) @db.Timestamptz(6)
  error_map_entry                                                           error_map_entry[]
  exercise                                                                  exercise            @relation(fields: [exercise_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  app_user                                                                  app_user            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  review_queue_item_review_queue_item_resolved_attempt_idToexercise_attempt review_queue_item[] @relation("review_queue_item_resolved_attempt_idToexercise_attempt")
  review_queue_item_review_queue_item_source_attempt_idToexercise_attempt   review_queue_item[] @relation("review_queue_item_source_attempt_idToexercise_attempt")

  @@index([user_id, exercise_id], map: "attempt_user_ex_idx")
  @@index([user_id, answered_at], map: "attempt_user_time_idx")
}

model exercise_type {
  code        String     @id
  label       String
  interaction String
  exercise    exercise[]
}

model flashcard {
  id                 BigInt            @id @default(autoincrement())
  module_id          BigInt?
  note_type          note_type
  fields             Json
  source             flashcard_source  @default(content)
  vocab_entry_id     BigInt?
  source_exercise_id BigInt?
  source_gloss_id    BigInt?
  created_by_user_id BigInt?
  archived           Boolean           @default(false)
  content_hash       String?
  created_at         DateTime          @default(now()) @db.Timestamptz(6)
  ident              String?           @unique(map: "flashcard_ident_uniq")
  card_review_log    card_review_log[]
  card_state         card_state[]
  error_map_entry    error_map_entry[]
  app_user           app_user?         @relation(fields: [created_by_user_id], references: [id], onUpdate: NoAction)
  module             module?           @relation(fields: [module_id], references: [id], onUpdate: NoAction)
  exercise           exercise?         @relation(fields: [source_exercise_id], references: [id], onUpdate: NoAction)
  gloss              gloss?            @relation(fields: [source_gloss_id], references: [id], onUpdate: NoAction)
  vocab_entry        vocab_entry?      @relation(fields: [vocab_entry_id], references: [id], onUpdate: NoAction)

  @@index([module_id], map: "flashcard_module_idx")
}

model gloss {
  id              BigInt       @id @default(autoincrement())
  reading_text_id BigInt
  key             String
  term            String
  pos_label       String?
  definition      String
  example         String?
  flashcard       flashcard[]
  reading_text    reading_text @relation(fields: [reading_text_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([reading_text_id, key])
}

model grammar_point {
  id                 BigInt               @id @default(autoincrement())
  module_id          BigInt
  title              String
  position           Int                  @default(1)
  content_hash       String?
  exercise           exercise[]
  module             module               @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_grammar_state user_grammar_state[]

  @@unique([module_id, title])
}

model grammar_spotlight {
  id           BigInt  @id @default(autoincrement())
  module_id    BigInt
  title        String
  intro        String?
  items        Json    @default("[]")
  position     Int     @default(1)
  content_hash String?
  module       module  @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([module_id, position])
}

model module {
  id                BigInt              @id @default(autoincrement())
  block_id          BigInt
  slug              String
  title             String
  standfirst        String?
  goals             Json                @default("[]")
  planned_minutes   Int                 @default(270)
  position          Int
  content_hash      String?
  error_map_entry   error_map_entry[]
  exercise          exercise[]
  flashcard         flashcard[]
  grammar_point     grammar_point[]
  grammar_spotlight grammar_spotlight[]
  block             block               @relation(fields: [block_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  module_review     module_review[]
  reading_text      reading_text[]
  study_session     study_session[]
  user_module_state user_module_state[]
  vocab_entry       vocab_entry[]
  watchout          watchout[]
  writing_task      writing_task[]

  @@unique([block_id, position])
  @@unique([block_id, slug])
}

model module_review {
  id        BigInt       @id @default(autoincrement())
  user_id   BigInt
  module_id BigInt
  stage     review_stage
  due_at    DateTime     @db.Timestamptz(6)
  taken_at  DateTime?    @db.Timestamptz(6)
  score     Decimal?     @db.Decimal(5, 2)
  passed    Boolean?
  module    module       @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  app_user  app_user     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, module_id, stage])
}

model reading_text {
  id           BigInt       @id @default(autoincrement())
  module_id    BigInt
  kind         reading_kind
  kicker       String?
  title        String
  meta         String?
  body         Json
  word_count   Int?
  position     Int          @default(1)
  content_hash String?
  exercise     exercise[]
  gloss        gloss[]
  module       module       @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([module_id, kind, position])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model review_queue_item {
  id                                                                       BigInt            @id @default(autoincrement())
  user_id                                                                  BigInt
  exercise_id                                                              BigInt
  stage                                                                    Int               @default(1) @db.SmallInt
  due_at                                                                   DateTime          @db.Timestamptz(6)
  source_attempt_id                                                        BigInt?
  resolved_at                                                              DateTime?         @db.Timestamptz(6)
  resolved_attempt_id                                                      BigInt?
  created_at                                                               DateTime          @default(now()) @db.Timestamptz(6)
  exercise                                                                 exercise          @relation(fields: [exercise_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  exercise_attempt_review_queue_item_resolved_attempt_idToexercise_attempt exercise_attempt? @relation("review_queue_item_resolved_attempt_idToexercise_attempt", fields: [resolved_attempt_id], references: [id], onUpdate: NoAction)
  exercise_attempt_review_queue_item_source_attempt_idToexercise_attempt   exercise_attempt? @relation("review_queue_item_source_attempt_idToexercise_attempt", fields: [source_attempt_id], references: [id], onUpdate: NoAction)
  app_user                                                                 app_user          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model schema_migrations {
  filename   String   @id
  applied_at DateTime @default(now()) @db.Timestamptz(6)
}

model session_step {
  id               BigInt            @id @default(autoincrement())
  study_session_id BigInt
  position         Int
  kind             step_kind
  title            String
  detail           String?
  planned_minutes  Int               @default(10)
  config           Json              @default("{}")
  study_session    study_session     @relation(fields: [study_session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_step_state  user_step_state[]

  @@unique([study_session_id, position])
}

model study_session {
  id                 BigInt               @id @default(autoincrement())
  module_id          BigInt
  session_type       session_type
  position           Int
  title              String
  planned_minutes    Int
  session_step       session_step[]
  module             module               @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_session_state user_session_state[]

  @@unique([module_id, position])
  @@unique([module_id, session_type])
}

model user_checkpoint_state {
  user_id       BigInt
  checkpoint_id BigInt
  status        checkpoint_status @default(locked)
  best_score    Decimal?          @db.Decimal(5, 2)
  taken_at      DateTime?         @db.Timestamptz(6)
  checkpoint    checkpoint        @relation(fields: [checkpoint_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  app_user      app_user          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, checkpoint_id])
}

model user_course {
  user_id    BigInt
  course_id  BigInt
  started_at DateTime @default(now()) @db.Timestamptz(6)
  is_active  Boolean  @default(true)
  course     course   @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  app_user   app_user @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, course_id])
}

model user_grammar_state {
  user_id          BigInt
  grammar_point_id BigInt
  status           grammar_status @default(introduced)
  success_count    Int            @default(0)
  updated_at       DateTime       @default(now()) @db.Timestamptz(6)
  grammar_point    grammar_point  @relation(fields: [grammar_point_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  app_user         app_user       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, grammar_point_id])
}

model user_module_state {
  user_id      BigInt
  module_id    BigInt
  status       module_status @default(locked)
  started_at   DateTime?     @db.Timestamptz(6)
  completed_at DateTime?     @db.Timestamptz(6)
  quiz_score   Decimal?      @db.Decimal(5, 2)
  mastered_at  DateTime?     @db.Timestamptz(6)
  module       module        @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  app_user     app_user      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, module_id])
}

model user_session_state {
  user_id          BigInt
  study_session_id BigInt
  status           progress_status @default(not_started)
  started_at       DateTime?       @db.Timestamptz(6)
  completed_at     DateTime?       @db.Timestamptz(6)
  study_session    study_session   @relation(fields: [study_session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  app_user         app_user        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, study_session_id])
}

model user_step_state {
  user_id         BigInt
  session_step_id BigInt
  status          progress_status @default(not_started)
  completed_at    DateTime?       @db.Timestamptz(6)
  session_step    session_step    @relation(fields: [session_step_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  app_user        app_user        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, session_step_id])
}

model user_vocab_state {
  user_id              BigInt
  vocab_entry_id       BigInt
  status               vocab_status        @default(new)
  in_use_submission_id BigInt?
  updated_at           DateTime            @default(now()) @db.Timestamptz(6)
  writing_submission   writing_submission? @relation(fields: [in_use_submission_id], references: [id], onUpdate: NoAction)
  app_user             app_user            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vocab_entry          vocab_entry         @relation(fields: [vocab_entry_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, vocab_entry_id])
}

model vocab_entry {
  id               BigInt             @id @default(autoincrement())
  module_id        BigInt
  term             String
  tag              String?
  definition       String
  use_cases        Json               @default("[]")
  collocations     String?
  register_note    String?
  position         Int
  content_hash     String?
  flashcard        flashcard[]
  user_vocab_state user_vocab_state[]
  module           module             @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([module_id, term])
}

model watchout {
  id           BigInt  @id @default(autoincrement())
  module_id    BigInt
  title        String
  bad_example  String
  good_example String
  note         String?
  position     Int     @default(1)
  content_hash String?
  module       module  @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([module_id, position])
}

model writing_submission {
  id               BigInt             @id @default(autoincrement())
  user_id          BigInt
  writing_task_id  BigInt
  body_md          String
  duration_min     Int?
  self_check       Json?
  attachment_url   String?
  submitted_at     DateTime           @default(now()) @db.Timestamptz(6)
  error_map_entry  error_map_entry[]
  user_vocab_state user_vocab_state[]
  app_user         app_user           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  writing_task     writing_task       @relation(fields: [writing_task_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, submitted_at], map: "submission_user_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model writing_task {
  id                 BigInt               @id @default(autoincrement())
  module_id          BigInt?
  checkpoint_id      BigInt?
  mode               task_mode
  genre              String
  prompt_md          String
  model_answer_md    String?
  checklist          Json                 @default("[]")
  position           Int                  @default(1)
  content_hash       String?
  ident              String?
  word_min           Int?
  word_max           Int?
  writing_submission writing_submission[]
  checkpoint         checkpoint?          @relation(fields: [checkpoint_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  module             module?              @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

enum attempt_context {
  session
  review_slot
  module_quiz
  module_review
  checkpoint
  practice
}

enum card_phase {
  new
  learning
  review
  relearning
}

enum checkpoint_kind {
  diagnostic
  block
  final
}

enum checkpoint_status {
  locked
  available
  passed
  failed
}

enum error_source {
  exercise
  writing
  manual
}

enum exercise_group {
  grammar
  reading
  vocab
}

enum exercise_pool {
  core
  review
}

enum flashcard_source {
  content
  error_harvest
  gloss
  manual
}

enum grammar_status {
  introduced
  practising
  reliable
}

enum module_status {
  locked
  upcoming
  in_progress
  completed
  mastered
}

enum note_type {
  vocab
  grammar_cloze
  transformation
  vocab_reverse
}

enum progress_status {
  not_started
  in_progress
  done
}

enum reading_kind {
  main
  extra
}

enum review_stage {
  r7
  r21
}

enum session_type {
  prime
  input
  workout
  output
}

enum step_kind {
  opener
  theory
  reading
  vocab
  exercise_set
  review_slot
  harvest
  production
  self_check
  module_quiz
  flashcards_intro
}

enum task_mode {
  writing
  speaking
}

enum vocab_status {
  new
  learning
  known
  in_use
}
